    "@types/react": "16.9.56",
    "@types/react-dom": "16.9.9",
    "babel-loader": "8.3.0",
    "clean-webpack-plugin": "3.0.0",
    "css-loader": "4.3.0",
    "file-loader": "6.2.0",
    "html-webpack-plugin": "4.5.0",
    "mini-css-extract-plugin": "0.11.3",
    "optimize-css-assets-webpack-plugin": "5.0.4",
    "style-loader": "1.3.0",
    "terser-webpack-plugin": "4.2.3",
    "ts-loader": "6.2.1",
    "typescript": "4.4.4",
    "url-loader": "4.1.1",
    "webpack": "4.44.2",
    "webpack-cli": "3.3.11",
    "webpack-dev-server": "3.11.1"
